{
  "compilerOptions": {
    "moduleResolution": "node16",
    "module": "node16",
    "target": "es2018",
    "lib": ["es2018"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "./src"
  },
  "include": ["./src"],
  "exclude": ["node_modules", "dist"]
}