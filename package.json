{
	"name": "json-canonicalize",
	"version": "2.0.1",
	"description": "JSON canonicalize function ",
	"keywords": [
		"json",
		"canonical",
		"canonicalize",
		"canonicalization",
		"serialization",
		"lexicographic",
		"sign",
		"signature",
		"signing",
		"crypto"
	],
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/snowyu/json-canonicalize.ts"
	},
	"author": "Riceball LEE <snowyu.lee@gmail.com>",
	"license": "MIT",
	"engines": {
		"node": ">=8.5"
	},
	"scripts": {
		"build": "tsup",
		"test": "jest -c ./config/jest.config.js",
		"test:watch": "npm t -- --watch",
		"test:coverage": "npm t -- --coverage",
		"test:ci": "npm t -- --ci",
		"validate": "tsc --noEmit",
		"lint": "eslint 'src/**/*.{ts,tsx}'",
		"lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
		"prerelease": "npm run build",
		"release": "npx standard-version",
		"release:github": "git push --no-verify --follow-tags origin master",
		"release:npm": "npm publish",
		"prepublishOnly": "npm run build"
	},
	"config": {
		"commitizen": {
			"path": "cz-conventional-changelog"
		}
	},
	"husky": {
		"hooks": {
			"commit-msg": "commitlint --config config/commitlint.config.js -E HUSKY_GIT_PARAMS",
			"pre-commit": "lint-staged",
			"pre-push": "npm run lint && npm test -- --bail --onlyChanged"
		}
	},
	"lint-staged": {
		"**/*.{ts,tsx,js,jsx,css,scss,sass,less,md}": [
			"prettier --write",
			"git add"
		],
		"src/**/*.{ts,tsx}": [
			"eslint --fix",
			"git add"
		]
	},
	"peerDependencies": {},
	"dependencies": {},
	"devDependencies": {
		"@commitlint/cli": "~12.1.1",
		"@commitlint/config-conventional": "~12.1.1",
		"@types/jest": "~26.0.23",
		"@types/node": "^15.0.2",
		"commitizen": "~4.2.3",
		"cz-conventional-changelog": "~3.3.0",
		"husky": "~6.0.0",
		"jest": "~26.6.3",
		"jest-watch-typeahead": "~0.6.3",
		"kleur": "~4.1.4",
		"lint-staged": "~10.5.4",
		"prettier": "~2.2.1",

		"ts-jest": "~26.5.6",
		"eslint": "^8.56.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"eslint-config-prettier": "^9.1.0",
		"tsup": "^8.0.0",
		"typescript": "^4.9.5"
	}
}